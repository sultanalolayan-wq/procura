# ARES — environment. Copy to .env and edit. Every value shown is the DEFAULT
# that applies when the variable is absent or empty, so an untouched copy of
# this file behaves exactly like no .env at all.
#
# Money is always an INTEGER COUNT OF MINOR UNITS (halalas/cents). 100000 is
# SAR 1000.00. There are no floats anywhere in this system.

# ---------------------------------------------------------------- core ------

# Operating mode. PAPER is the only accepted value; anything else refuses to
# start. LIVE execution is deliberately not implemented. See README.
ARES_MODE=PAPER

# Seed for every random stream. The same seed replays the same run byte for byte.
ARES_SEED=1337

# Base currency for the ledger and every adapter. SAR or USD.
ARES_BASE_CURRENCY=SAR

# Milliseconds between ticks. Minimum 250. The scheduler is drift-corrected, so
# this is a real cadence, not a "sleep this long after the work".
ARES_TICK_MS=5000

# Where the ledger, memory stores and snapshots live. Back this up; losing it
# loses the audit trail.
ARES_DATA_DIR=./var

# debug | info | warn | error. Logs are JSON lines on stdout, with any key
# matching /token|secret|key|password|authorization/i redacted.
ARES_LOG_LEVEL=info

# Ticks between state snapshots (snapshot + flush every MemoryStore). 0 disables.
ARES_SNAPSHOT_EVERY=20

# ----------------------------------------------------------------- api ------

# Interface the operator API binds. Keep it on loopback. If this is NOT a
# loopback address and ARES_API_TOKEN is unset, the process REFUSES TO START.
ARES_API_HOST=127.0.0.1

# TCP port for the API and the dashboard.
ARES_API_PORT=8787

# Bearer token for mutating routes (POST /api/halt). When it is unset, mutating
# routes are refused outright — even on loopback — and halting is done by
# creating the file $ARES_DATA_DIR/HALT instead. Use a long random secret:
#   openssl rand -hex 32
#
# LEAVING THIS EMPTY IS FINE FOR `npm start` ON LOOPBACK. It is NOT fine under
# docker compose: the container binds 0.0.0.0, ARES refuses to start an
# unauthenticated non-loopback API, and `docker compose up` will stop with an
# error naming this variable. Fill it in before running the container.
#
# With no token the dashboard's red HALT button answers 401. That is the design,
# not a fault — but the operator must know the out-of-band halt:
#   touch $ARES_DATA_DIR/HALT
ARES_API_TOKEN=

# -------------------------------------------------------------- budget ------

# Hard ceiling on cash the swarm may ever hold, in minor units.
ARES_CASH_CAP=100000

# Opening cash. Must not exceed ARES_CASH_CAP.
ARES_STARTING_CASH=100000

# Loss from the opening balance that halts the whole swarm, in minor units.
ARES_MAX_DRAWDOWN=20000

# Cash headroom one agent may hold at a time.
ARES_AGENT_CASH_CAP=25000

# Ceiling on a single trade. Must not exceed ARES_AGENT_CASH_CAP.
ARES_TRADE_CAP=5000

# Total token budget for the whole swarm.
ARES_TOKEN_CAP=2000000

# Token budget per agent. Must not exceed ARES_TOKEN_CAP.
ARES_AGENT_TOKEN_CAP=500000

# Minor units charged to the ledger per million tokens (the compute account).
ARES_TOKEN_PRICE=1875

# ------------------------------------------------------------ survival ------

# Ticks in one evaluation window. Verdicts are taken at window boundaries.
ARES_WINDOW_TICKS=20

# Windows of cold-start immunity before an agent can be judged at all.
ARES_GRACE_WINDOWS=2

# Outcomes required before a verdict is statistically meaningful.
ARES_MIN_SAMPLES=8

# Consecutive failing mature windows before TERMINATE (1 = probation, then out).
ARES_PROBATION_WINDOWS=1

# Net cash flow, in minor units, an agent must clear in a window to PASS.
ARES_MIN_NET=0

# --- OPERATOR'S LITERAL ZERO-TOLERANCE POLICY -------------------------------
# Uncomment the three lines below to enforce "an agent that does not make money
# dies", with no cold-start grace, no statistical floor and no second chance:
#
#   ARES_GRACE_WINDOWS=0
#   ARES_MIN_SAMPLES=0
#   ARES_PROBATION_WINDOWS=0
#
# The trade-off: with zero grace and zero minimum samples, the FIRST window is
# judged on whatever happened to land in it, so an agent whose strategy is sound
# but slow to settle a sale is terminated on noise before it has produced a
# single comparable data point. The defaults above (2 grace windows, 8 samples,
# 1 probation window) keep the same rule but only apply it once there is enough
# evidence for the verdict to mean something — the rule is unchanged, only its
# evidence bar is.
# ---------------------------------------------------------------------------

# -------------------------------------------------------------- limits ------

# Guarded actions one agent may take in one tick.
ARES_MAX_ACTIONS=4

# Maximum causal hops a bus message may travel before it is dropped.
ARES_MAX_HOPS=6

# Bus queue depth at which publishes are dropped (backpressure).
ARES_MAX_QUEUE=1000

# Ticks the bus loop guard looks back over.
ARES_REPEAT_WINDOW=12

# Identical messages within that window before the loop guard drops them.
ARES_REPEAT_THRESHOLD=4

# Rate limit on external (simulated channel) calls, per agent, per minute.
ARES_RATE_PER_MIN=120

# A tick longer than this logs a watchdog warning; three CONSECUTIVE overruns
# trip the kill switch and halt the swarm.
ARES_TICK_WATCHDOG_MS=20000

# Crashes before the supervisor quarantines an agent (stops ticking it). This is
# NOT termination — terminating an agent remains the Treasury's decision.
ARES_MAX_CRASHES=3

# ------------------------------------------------------------ channels ------

# Comma-separated channel allow-list. Each one is still gated by the policy
# engine at boot, and a channel that fails the gate is rejected and logged.
#
# ksa_ecom is a SELL-ONLY channel. It declares canBuy=false and its buy() throws
# unconditionally, because automated purchasing is assumed to be prohibited by
# the platforms it models. It IS admitted at boot and its sell path, SAR pricing
# and VAT handling do run. (Until recently it declared canBuy=true AND
# "buyRequiresHumanApproval", which the policy engine correctly read as an
# inconsistent capability set and used to reject the WHOLE adapter — so the
# Saudi capability was dead code behind an accurate-looking channel name.)
#
# Note that a sell-only channel has no automated way to acquire stock: in a
# default run the swarm has no inventory to list on ksa_ecom, so it produces no
# sales. That is the honest consequence of having no human in the loop, not a
# bug — see README, "Channels are gated".
#
# Booting with NO usable channel left is a hard failure, not an idle swarm.
ARES_CHANNELS=dataproducts,digitalassets,ksa_ecom

# ------------------------------------------------- market data (PAPER) ------
#
# The equities channel paper-trades against REAL bars. Everything below is OFF
# or EMPTY by default: with no variables set, the market module reaches nothing,
# trades nothing and assumes no holiday it was not given.
#
# READ-ONLY NETWORK BOUNDARY: the market module issues GET and nothing else.
# There is no POST/PUT/PATCH/DELETE in the repository, and orders never leave
# the process — fills are modelled locally against bars. See README, "The
# network boundary, stated precisely".

# Master switch. When true, ARES_MARKET_START_DAY and at least one symbol list
# are required, or the process refuses to start.
ARES_MARKET_ENABLED=false

# First SESSION of the run (YYYY-MM-DD). It is snapped forward to each venue's
# own next session, so the US and Tadawul windows differ from here on.
# ARES_MARKET_START_DAY=2025-01-06

# Nominal run length in SESSIONS, applied PER VENUE. Ten US sessions and ten
# Tadawul sessions are NOT the same calendar days; the report prints both.
ARES_MARKET_SESSIONS=10

# Instrument universe per venue. Symbols map to
# <ARES_DATA_DIR>/market/<venue>/<symbol>.csv for the offline feed.
ARES_MARKET_US_SYMBOLS=
ARES_MARKET_TADAWUL_SYMBOLS=

# Exchange holidays, operator-supplied, comma-separated YYYY-MM-DD.
#
# DELIBERATELY EMPTY. No holiday is shipped as fact: exchange calendars are
# published per year and Eid dates are lunar, so a stale hardcoded list is worse
# than none because it is believed. Copy the venue's own published calendar for
# the period you are running. With an empty list a closed holiday is counted as
# a session — visible in replay as a missing bar, and printed as "EMPTY LIST"
# next to the venue in the run report.
ARES_MARKET_US_HOLIDAYS=
ARES_MARKET_TADAWUL_HOLIDAYS=

# --- cost model, per venue. UNVERIFIED ASSUMPTIONS ---------------------------
# The defaults are plausible retail figures chosen to be PESSIMISTIC rather than
# flattering. No broker tariff has been read or verified. Replace them with your
# own broker's schedule before treating any P&L figure as meaningful. An
# optimistic cost model is how a backtest lies about a strategy that only works
# for free.
#
# COMMISSION_BPS       per SIDE, basis points of notional
# MIN_COMMISSION       floor on the per-side commission, in minor units
# HALF_SPREAD_BPS      half the quoted bid-ask, charged adversely on every fill
# SLIPPAGE_BPS         adverse move between decision and execution
# SETTLEMENT_SESSIONS  T+2 by default, counted in SESSIONS not calendar days
# LOT_SIZE             minimum tradeable increment, in shares
ARES_MARKET_US_COMMISSION_BPS=10
ARES_MARKET_US_MIN_COMMISSION=100
ARES_MARKET_US_HALF_SPREAD_BPS=2
ARES_MARKET_US_SLIPPAGE_BPS=3
ARES_MARKET_US_SETTLEMENT_SESSIONS=2
ARES_MARKET_US_LOT_SIZE=1

ARES_MARKET_TADAWUL_COMMISSION_BPS=16
ARES_MARKET_TADAWUL_MIN_COMMISSION=100
ARES_MARKET_TADAWUL_HALF_SPREAD_BPS=5
ARES_MARKET_TADAWUL_SLIPPAGE_BPS=5
ARES_MARKET_TADAWUL_SETTLEMENT_SESSIONS=2
ARES_MARKET_TADAWUL_LOT_SIZE=1

# --- FX ----------------------------------------------------------------------
# SAR per USD, up to 6 decimal places, parsed exactly (no float rounding).
#
# CONFIGURED ASSUMPTION, NOT A LAW OF NATURE — labelled here exactly as the VAT
# rate is. The riyal's peg to the dollar is a policy of the Saudi Central Bank;
# policies change, no live rate is fetched, and no conversion spread is modelled.
# Cross-currency P&L is only as good as this one number.
ARES_MARKET_FX_SAR_PER_USD=3.75

# --- HTTP feed (unused unless you set a host) --------------------------------
# Host allowlist for the READ-ONLY price feed. EMPTY BY DEFAULT: deny everything.
# Bare hostnames only — no scheme, no port, no wildcard. Matching is EXACT, so
# "evil-stooq.com" is not "stooq.com". Redirects are re-checked against this same
# list on every hop.
#
# Before naming a host here: confirm IN WRITING, for your own jurisdiction and
# use, that the provider's terms of use permit automated retrieval. No provider's
# terms have been read or verified by this code, and an API key is not permission.
ARES_MARKET_HOSTS=
ARES_MARKET_HTTP_TIMEOUT_MS=8000
ARES_MARKET_HTTP_MAX_BYTES=2000000
ARES_MARKET_HTTP_MAX_REDIRECTS=2
ARES_MARKET_HTTP_PER_MIN=30
ARES_MARKET_HTTP_FAILURES=3
ARES_MARKET_HTTP_COOLDOWN_MS=60000
ARES_MARKET_HTTP_HALF_OPEN_MAX=1

# --- CSV feed ceilings -------------------------------------------------------
# The file is streamed, never slurped, and both ceilings are enforced while
# reading. 32 MiB is roughly forty years of daily bars for one instrument.
ARES_MARKET_CSV_MAX_BYTES=33554432
ARES_MARKET_CSV_MAX_ROWS=200000
