# ARES — environment. Copy to .env and edit. Every value shown is the DEFAULT
# that applies when the variable is absent or empty, so an untouched copy of
# this file behaves exactly like no .env at all.
#
# Money is always an INTEGER COUNT OF MINOR UNITS (halalas/cents). 100000 is
# SAR 1000.00. There are no floats anywhere in this system.

# ---------------------------------------------------------------- core ------

# Operating mode. PAPER is the only accepted value; anything else refuses to
# start. LIVE execution is deliberately not implemented. See README.
ARES_MODE=PAPER

# Seed for every random stream. The same seed replays the same run byte for byte.
ARES_SEED=1337

# Base currency for the ledger and every adapter. SAR or USD.
ARES_BASE_CURRENCY=SAR

# Milliseconds between ticks. Minimum 250. The scheduler is drift-corrected, so
# this is a real cadence, not a "sleep this long after the work".
ARES_TICK_MS=5000

# Where the ledger, memory stores and snapshots live. Back this up; losing it
# loses the audit trail.
ARES_DATA_DIR=./var

# debug | info | warn | error. Logs are JSON lines on stdout, with any key
# matching /token|secret|key|password|authorization/i redacted.
ARES_LOG_LEVEL=info

# Ticks between state snapshots (snapshot + flush every MemoryStore). 0 disables.
ARES_SNAPSHOT_EVERY=20

# ----------------------------------------------------------------- api ------

# Interface the operator API binds. Keep it on loopback. If this is NOT a
# loopback address and ARES_API_TOKEN is unset, the process REFUSES TO START.
ARES_API_HOST=127.0.0.1

# TCP port for the API and the dashboard.
ARES_API_PORT=8787

# Bearer token for mutating routes (POST /api/halt). When it is unset, mutating
# routes are refused outright — even on loopback — and halting is done by
# creating the file $ARES_DATA_DIR/HALT instead. Use a long random secret:
#   openssl rand -hex 32
ARES_API_TOKEN=

# -------------------------------------------------------------- budget ------

# Hard ceiling on cash the swarm may ever hold, in minor units.
ARES_CASH_CAP=100000

# Opening cash. Must not exceed ARES_CASH_CAP.
ARES_STARTING_CASH=100000

# Loss from the opening balance that halts the whole swarm, in minor units.
ARES_MAX_DRAWDOWN=20000

# Cash headroom one agent may hold at a time.
ARES_AGENT_CASH_CAP=25000

# Ceiling on a single trade. Must not exceed ARES_AGENT_CASH_CAP.
ARES_TRADE_CAP=5000

# Total token budget for the whole swarm.
ARES_TOKEN_CAP=2000000

# Token budget per agent. Must not exceed ARES_TOKEN_CAP.
ARES_AGENT_TOKEN_CAP=500000

# Minor units charged to the ledger per million tokens (the compute account).
ARES_TOKEN_PRICE=1875

# ------------------------------------------------------------ survival ------

# Ticks in one evaluation window. Verdicts are taken at window boundaries.
ARES_WINDOW_TICKS=20

# Windows of cold-start immunity before an agent can be judged at all.
ARES_GRACE_WINDOWS=2

# Outcomes required before a verdict is statistically meaningful.
ARES_MIN_SAMPLES=8

# Consecutive failing mature windows before TERMINATE (1 = probation, then out).
ARES_PROBATION_WINDOWS=1

# Net cash flow, in minor units, an agent must clear in a window to PASS.
ARES_MIN_NET=0

# --- OPERATOR'S LITERAL ZERO-TOLERANCE POLICY -------------------------------
# Uncomment the three lines below to enforce "an agent that does not make money
# dies", with no cold-start grace, no statistical floor and no second chance:
#
#   ARES_GRACE_WINDOWS=0
#   ARES_MIN_SAMPLES=0
#   ARES_PROBATION_WINDOWS=0
#
# The trade-off: with zero grace and zero minimum samples, the FIRST window is
# judged on whatever happened to land in it, so an agent whose strategy is sound
# but slow to settle a sale is terminated on noise before it has produced a
# single comparable data point. The defaults above (2 grace windows, 8 samples,
# 1 probation window) keep the same rule but only apply it once there is enough
# evidence for the verdict to mean something — the rule is unchanged, only its
# evidence bar is.
# ---------------------------------------------------------------------------

# -------------------------------------------------------------- limits ------

# Guarded actions one agent may take in one tick.
ARES_MAX_ACTIONS=4

# Maximum causal hops a bus message may travel before it is dropped.
ARES_MAX_HOPS=6

# Bus queue depth at which publishes are dropped (backpressure).
ARES_MAX_QUEUE=1000

# Ticks the bus loop guard looks back over.
ARES_REPEAT_WINDOW=12

# Identical messages within that window before the loop guard drops them.
ARES_REPEAT_THRESHOLD=4

# Rate limit on external (simulated channel) calls, per agent, per minute.
ARES_RATE_PER_MIN=120

# A tick longer than this logs a watchdog warning; three CONSECUTIVE overruns
# trip the kill switch and halt the swarm.
ARES_TICK_WATCHDOG_MS=20000

# Crashes before the supervisor quarantines an agent (stops ticking it). This is
# NOT termination — terminating an agent remains the Treasury's decision.
ARES_MAX_CRASHES=3

# ------------------------------------------------------------ channels ------

# Comma-separated channel allow-list. Each one is still gated by the policy
# engine at boot, and a channel that fails the gate is rejected and logged.
# Note: ksa_ecom declares that its terms of service require human approval for
# every purchase, and ARES has no human in the loop, so the policy engine
# refuses it as a BUY channel at boot. That refusal is the system working.
# Booting with NO usable channel left is a hard failure, not an idle swarm.
ARES_CHANNELS=dataproducts,digitalassets,ksa_ecom
